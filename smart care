        // --- 3D THREE.JS CANVAS ANIMATION (MEDICAL CROSS + DNA HELIX) ---
        let scene, camera, renderer, medicalGroup;

        function init3DCanvas() {
            const canvas = document.getElementById('canvas3d');
            if (!canvas || scene) return;

            const container = canvas.parentElement;
            const width = container.clientWidth;
            const height = container.clientHeight;

            scene = new THREE.Scene();
            camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 1000);
            camera.position.set(0, 0, 15);

            renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true, alpha: true });
            renderer.setSize(width, height);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

            const ambientLight = new THREE.AmbientLight(0xffffff, 0.8);
            scene.add(ambientLight);

            const pointLight1 = new THREE.PointLight(0x4caf50, 2.5, 50);
            pointLight1.position.set(10, 10, 10);
            scene.add(pointLight1);

            const pointLight2 = new THREE.PointLight(0x00bcd4, 2, 50);
            pointLight2.position.set(-10, -10, 10);
            scene.add(pointLight2);

            medicalGroup = new THREE.Group();

            // 3D Medical Cross
            const crossMat = new THREE.MeshStandardMaterial({
                color: 0x2e7d32,
                metalness: 0.3,
                roughness: 0.2
            });
            const vertGeo = new THREE.BoxGeometry(1.2, 4.2, 1.2);
            const horizGeo = new THREE.BoxGeometry(4.2, 1.2, 1.2);
            medicalGroup.add(new THREE.Mesh(vertGeo, crossMat));
            medicalGroup.add(new THREE.Mesh(horizGeo, crossMat));

            // Floating DNA Helix Spheres
            const helixGroup = new THREE.Group();
            const sphereGeo = new THREE.SphereGeometry(0.18, 16, 16);
            const mat1 = new THREE.MeshBasicMaterial({ color: 0x81c784 });
            const mat2 = new THREE.MeshBasicMaterial({ color: 0x64b5f6 });

            for (let i = 0; i < 24; i++) {
                const t = i * 0.4;
                const x1 = Math.sin(t) * 3.2;
                const y1 = (i - 12) * 0.4;
                const z1 = Math.cos(t) * 3.2;

                const s1 = new THREE.Mesh(sphereGeo, mat1);
                s1.position.set(x1, y1, z1);
                helixGroup.add(s1);

                const s2 = new THREE.Mesh(sphereGeo, mat2);
                s2.position.set(-x1, y1, -z1);
                helixGroup.add(s2);
            }
            medicalGroup.add(helixGroup);

            // Orbiting Ring
            const ringGeo = new THREE.TorusGeometry(4.5, 0.05, 16, 100);
            const ringMat = new THREE.MeshBasicMaterial({ color: 0xa5d6a7, wireframe: true });
            const ring = new THREE.Mesh(ringGeo, ringMat);
            ring.rotation.x = Math.PI / 3;
            medicalGroup.add(ring);

            scene.add(medicalGroup);

            // Background Particle Stars
            const pCount = 150;
            const pGeo = new THREE.BufferGeometry();
            const pPos = new Float32Array(pCount * 3);
            for (let i = 0; i < pCount * 3; i++) {
                pPos[i] = (Math.random() - 0.5) * 24;
            }
            pGeo.setAttribute('position', new THREE.BufferAttribute(pPos, 3));
            const pMat = new THREE.PointsMaterial({ color: 0xa5d6a7, size: 0.12, transparent: true, opacity: 0.7 });
            scene.add(new THREE.Points(pGeo, pMat));

            window.addEventListener('resize', onWindowResize);
            animate3D();
        }

        function onWindowResize() {
            if (!camera || !renderer) return;
            const canvas = document.getElementById('canvas3d');
            if (!canvas) return;
            const container = canvas.parentElement;
            if (!container) return;

            camera.aspect = container.clientWidth / container.clientHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(container.clientWidth, container.clientHeight);
        }

        function animate3D() {
            requestAnimationFrame(animate3D);
            if (medicalGroup) {
                medicalGroup.rotation.y += 0.01;
                medicalGroup.rotation.x += 0.003;
            }
            if (renderer && scene && camera) {
                renderer.render(scene, camera);
            }
        }
    </script>
