<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SmartCare - A-Z Healthcare & Generic Medicine Finder</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Three.js for 3D Visuals -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#e8f5e9',
                            100: '#c8e6c9',
                            200: '#a5d6a7',
                            500: '#4caf50',
                            600: '#2e7d32',
                            700: '#1b5e20',
                            800: '#144718',
                            900: '#0d3110',
                            950: '#061a08',
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #f1f5f9; }
        ::-webkit-scrollbar-thumb { background: #a5d6a7; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #2e7d32; }

        .scan-line {
            height: 3px;
            background: linear-gradient(90deg, transparent, #4caf50, transparent);
            animation: scanAnim 2s infinite ease-in-out;
        }
        @keyframes scanAnim {
            0% { top: 0%; opacity: 0.8; }
            50% { top: 95%; opacity: 1; }
            100% { top: 0%; opacity: 0.8; }
        }

        .tab-btn.active {
            background-color: #2e7d32;
            color: #ffffff !important;
            box-shadow: 0 4px 12px rgba(46, 125, 50, 0.25);
        }
        .tab-btn.active i {
            color: #a5d6a7 !important;
        }

        .alpha-btn.active-letter {
            background-color: #1b5e20 !important;
            color: #ffffff !important;
            border-color: #1b5e20 !important;
            font-weight: 800;
        }
    </style>
</head>
<body class="bg-slate-50 font-sans text-slate-800 antialiased min-h-screen flex flex-col overflow-x-hidden">

    <!-- ========================================== -->
    <!-- 1. AUTHENTICATION PAGE (SIGN IN / SIGN UP) -->
    <!-- ========================================== -->
    <div id="authScreen" class="fixed inset-0 z-50 bg-gradient-to-br from-brand-950 via-brand-900 to-slate-900 flex items-center justify-center p-4">
        <!-- Ambient Decorative Glowing Orbs -->
        <div class="absolute w-96 h-96 bg-brand-500/20 rounded-full blur-3xl -top-10 -left-10 pointer-events-none"></div>
        <div class="absolute w-96 h-96 bg-emerald-400/10 rounded-full blur-3xl -bottom-10 -right-10 pointer-events-none"></div>

        <div class="w-full max-w-md bg-white/95 backdrop-blur-md rounded-2xl shadow-2xl border border-white/20 p-8 relative overflow-hidden">
            <!-- Brand Logo Header -->
            <div class="text-center space-y-2 mb-6">
                <div class="w-14 h-14 bg-brand-700 text-white rounded-2xl flex items-center justify-center mx-auto text-2xl shadow-lg shadow-brand-700/30">
                    <i class="fa-solid fa-heart-pulse"></i>
                </div>
                <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Smart<span class="text-brand-600">Care</span> Portal</h1>
                <p class="text-xs font-medium text-slate-500">A-Z Intelligent Healthcare & Generic Drug Directory</p>
            </div>

            <!-- Auth Mode Switch Tabs -->
            <div class="flex bg-slate-100 p-1 rounded-xl mb-6">
                <button id="tabSignInBtn" onclick="switchAuthMode('signin')" class="flex-1 py-2 text-xs font-bold rounded-lg text-brand-700 bg-white shadow-sm transition-all">Sign In</button>
                <button id="tabSignUpBtn" onclick="switchAuthMode('signup')" class="flex-1 py-2 text-xs font-bold rounded-lg text-slate-500 hover:text-slate-800 transition-all">Sign Up</button>
            </div>

            <!-- SIGN IN FORM -->
            <form id="signInForm" onsubmit="handleAuthSubmit(event, 'signin')" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Username or Email</label>
                    <div class="relative">
                        <i class="fa-solid fa-user absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                        <input type="text" id="signInUsername" required value="admin" placeholder="Enter username" 
                               class="w-full pl-9 pr-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:bg-white focus:ring-2 focus:ring-brand-600 focus:outline-none transition-all">
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Password</label>
                    <div class="relative">
                        <i class="fa-solid fa-lock absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                        <input type="password" id="signInPassword" required value="admin123" placeholder="••••••••" 
                               class="w-full pl-9 pr-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:bg-white focus:ring-2 focus:ring-brand-600 focus:outline-none transition-all">
                    </div>
                </div>
                <div class="flex items-center justify-between text-xs">
                    <label class="flex items-center space-x-2 text-slate-600 cursor-pointer">
                        <input type="checkbox" checked class="rounded text-brand-600 focus:ring-brand-500">
                        <span>Remember me</span>
                    </label>
                    <a href="#" onclick="alert('Demo reset instructions: Use admin / admin123 or click Quick Demo Access.')" class="text-brand-600 font-semibold hover:underline">Forgot password?</a>
                </div>
                <button type="submit" class="w-full py-3 bg-brand-700 hover:bg-brand-800 text-white font-bold text-sm rounded-lg shadow-lg shadow-brand-700/25 transition-all flex items-center justify-center space-x-2">
                    <span>Sign In to Dashboard</span>
                    <i class="fa-solid fa-arrow-right text-xs"></i>
                </button>
            </form>

            <!-- SIGN UP FORM -->
            <form id="signUpForm" onsubmit="handleAuthSubmit(event, 'signup')" class="space-y-4 hidden">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Full Name</label>
                    <div class="relative">
                        <i class="fa-solid fa-id-card absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                        <input type="text" id="signUpName" required placeholder="Dr. John Doe" 
                               class="w-full pl-9 pr-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:bg-white focus:ring-2 focus:ring-brand-600 focus:outline-none transition-all">
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Email Address</label>
                    <div class="relative">
                        <i class="fa-solid fa-envelope absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                        <input type="email" id="signUpEmail" required placeholder="john@smartcare.org" 
                               class="w-full pl-9 pr-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:bg-white focus:ring-2 focus:ring-brand-600 focus:outline-none transition-all">
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Choose Password</label>
                    <div class="relative">
                        <i class="fa-solid fa-key absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                        <input type="password" id="signUpPassword" required placeholder="Create password" 
                               class="w-full pl-9 pr-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:bg-white focus:ring-2 focus:ring-brand-600 focus:outline-none transition-all">
                    </div>
                </div>
                <button type="submit" class="w-full py-3 bg-brand-700 hover:bg-brand-800 text-white font-bold text-sm rounded-lg shadow-lg shadow-brand-700/25 transition-all flex items-center justify-center space-x-2">
                    <span>Create Account & Start</span>
                    <i class="fa-solid fa-user-plus text-xs"></i>
                </button>
            </form>

            <!-- Quick Demo Bypass -->
            <div class="mt-6 pt-5 border-t border-slate-200 text-center">
                <button onclick="loginAsDemo()" class="w-full py-2.5 bg-brand-50 hover:bg-brand-100 text-brand-700 font-bold text-xs rounded-lg border border-brand-200 transition-colors flex items-center justify-center space-x-2">
                    <i class="fa-solid fa-bolt"></i>
                    <span>Quick Demo Access (Skip Login)</span>
                </button>
                <p class="text-[11px] text-slate-400 mt-2">Default credentials: <code class="bg-slate-100 px-1 py-0.5 rounded text-slate-600">admin</code> / <code class="bg-slate-100 px-1 py-0.5 rounded text-slate-600">admin123</code></p>
            </div>
        </div>
    </div>

    <!-- ========================================== -->
    <!-- 2. MAIN APPLICATION WORKSPACE              -->
    <!-- ========================================== -->
    <div id="appContainer" class="flex-1 flex flex-col md:flex-row min-h-screen hidden">

        <!-- Mobile Header Bar -->
        <header class="md:hidden bg-brand-950 text-white p-4 flex justify-between items-center sticky top-0 z-40 shadow-md">
            <div class="flex items-center space-x-2">
                <span class="text-2xl">🩺</span>
                <span class="font-bold text-lg tracking-wide">Smart<span class="text-brand-400">Care</span></span>
            </div>
            <button onclick="toggleMobileSidebar()" class="p-2 text-slate-200 hover:text-white focus:outline-none">
                <i class="fa-solid fa-bars text-xl"></i>
            </button>
        </header>

        <!-- Sidebar Mobile Backdrop -->
        <div id="sidebarOverlay" onclick="toggleMobileSidebar()" class="fixed inset-0 bg-slate-900/50 z-40 hidden md:hidden transition-opacity"></div>

        <!-- LEFT SIDEBAR NAVIGATION -->
        <aside id="sidebar" class="fixed md:static inset-y-0 left-0 z-50 w-64 bg-brand-950 text-slate-200 flex flex-col justify-between transform -translate-x-full md:translate-x-0 transition-transform duration-300 ease-in-out shadow-2xl shrink-0">
            <div>
                <!-- Brand Header -->
                <div class="p-6 flex items-center justify-between border-b border-brand-900">
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 rounded-xl bg-brand-600 flex items-center justify-center text-white text-xl shadow-lg shadow-brand-600/30">
                            <i class="fa-solid fa-heart-pulse"></i>
                        </div>
                        <div>
                            <h1 class="font-bold text-xl tracking-wide text-white">Smart<span class="text-brand-500">Care</span></h1>
                            <p class="text-[10px] text-brand-200 font-medium tracking-wider uppercase">Health Directory</p>
                        </div>
                    </div>
                    <button onclick="toggleMobileSidebar()" class="md:hidden text-slate-400 hover:text-white">
                        <i class="fa-solid fa-xmark text-lg"></i>
                    </button>
                </div>

                <!-- Navigation Links -->
                <nav class="p-4 space-y-2">
                    <p class="px-3 text-[11px] font-bold text-brand-200 uppercase tracking-wider mb-2">Core Modules</p>
                    
                    <button onclick="switchTab('dashboard')" id="nav-dashboard" class="tab-btn active w-full flex items-center space-x-3 px-3.5 py-3 rounded-xl text-xs font-semibold transition-all text-slate-300 hover:bg-brand-900">
                        <i class="fa-solid fa-chart-line w-5 text-center text-brand-400"></i>
                        <span>Dashboard</span>
                    </button>

                    <button onclick="switchTab('find-medicines')" id="nav-find-medicines" class="tab-btn w-full flex items-center space-x-3 px-3.5 py-3 rounded-xl text-xs font-semibold transition-all text-slate-300 hover:bg-brand-900">
                        <i class="fa-solid fa-pills w-5 text-center text-brand-400"></i>
                        <span>Find Medicines (A-Z)</span>
                    </button>

                    <button onclick="switchTab('diet-assistance')" id="nav-diet-assistance" class="tab-btn w-full flex items-center space-x-3 px-3.5 py-3 rounded-xl text-xs font-semibold transition-all text-slate-300 hover:bg-brand-900">
                        <i class="fa-solid fa-apple-whole w-5 text-center text-brand-400"></i>
                        <span>Diet Assistance</span>
                    </button>

                    <button onclick="switchTab('scan-prescription')" id="nav-scan-prescription" class="tab-btn w-full flex items-center space-x-3 px-3.5 py-3 rounded-xl text-xs font-semibold transition-all text-slate-300 hover:bg-brand-900">
                        <i class="fa-solid fa-camera w-5 text-center text-brand-400"></i>
                        <span>Scan Prescription</span>
                    </button>
                </nav>
            </div>

            <!-- Profile & Logout Bottom Section -->
            <div class="p-4 border-t border-brand-900 bg-brand-950">
                <div class="flex items-center justify-between p-2.5 rounded-xl bg-brand-900/60 border border-brand-800/40">
                    <div class="flex items-center space-x-3 overflow-hidden">
                        <div id="userAvatar" class="w-9 h-9 rounded-lg bg-brand-600 text-white flex items-center justify-center font-bold text-sm shrink-0">
                            A
                        </div>
                        <div class="truncate">
                            <p id="userNameDisplay" class="text-xs font-bold text-white truncate">Admin User</p>
                            <p class="text-[10px] text-brand-200 truncate">Verified Account</p>
                        </div>
                    </div>
                    <button onclick="logout()" title="Sign Out" class="text-slate-400 hover:text-rose-400 p-2 transition-colors">
                        <i class="fa-solid fa-arrow-right-from-bracket"></i>
                    </button>
                </div>
            </div>
        </aside>

        <!-- MAIN WORKSPACE CONTENT CONTAINER -->
        <main class="flex-1 flex flex-col min-w-0 bg-slate-50 min-h-screen overflow-y-auto">
            
            <!-- Global Top Header Bar -->
            <header class="bg-white border-b border-slate-200 px-6 py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 sticky top-0 z-30 shadow-sm">
                <div>
                    <h2 id="activePageTitle" class="text-lg font-bold text-slate-800">SmartCare Overview</h2>
                    <p class="text-xs text-slate-500">A-Z Medicine Search & Clinical Wellness System</p>
                </div>
                <div class="flex items-center space-x-3">
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">
                        <span class="w-2 h-2 mr-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                        A-Z Database Online
                    </span>
                    <button onclick="switchTab('scan-prescription')" class="px-3 py-1.5 bg-brand-700 hover:bg-brand-800 text-white text-xs font-bold rounded-lg transition-colors shadow-sm">
                        + Scan Prescription
                    </button>
                </div>
            </header>

            <!-- ==================================================== -->
            <!-- TAB 1: DASHBOARD VIEW (WITH 3D CANVAS ON THE RIGHT)  -->
            <!-- ==================================================== -->
            <div id="tabView-dashboard" class="p-6 max-w-7xl w-full mx-auto space-y-6 flex-1">
                
                <!-- HERO BANNER WITH 3D CANVAS ANIMATION -->
                <div class="bg-gradient-to-r from-brand-950 via-brand-900 to-slate-900 rounded-2xl text-white overflow-hidden shadow-xl border border-brand-800/50 relative">
                    <div class="grid grid-cols-1 lg:grid-cols-12 min-h-[300px] items-center">
                        
                        <!-- Left Hero Details -->
                        <div class="lg:col-span-7 p-8 space-y-4 z-10">
                            <span class="inline-block px-3 py-1 bg-brand-500/20 text-brand-300 border border-brand-500/30 rounded-full text-xs font-semibold uppercase tracking-wider">
                                Comprehensive Healthcare Directory
                            </span>
                            <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight">
                                Welcome to <span class="text-brand-400">SmartCare</span>
                            </h1>
                            <p class="text-sm text-slate-300 leading-relaxed max-w-xl">
                                Instantly search medicines by letter from A to Z, discover generic alternatives, view dietary guidelines, or scan prescription photos for instant generic savings.
                            </p>
                            <div class="pt-2 flex flex-wrap gap-3">
                                <button onclick="switchTab('find-medicines')" class="px-5 py-2.5 bg-brand-600 hover:bg-brand-500 text-white text-xs font-bold rounded-xl shadow-lg shadow-brand-600/30 transition-all flex items-center space-x-2">
                                    <i class="fa-solid fa-magnifying-glass"></i>
                                    <span>Browse A-Z Medicines</span>
                                </button>
                                <button onclick="switchTab('scan-prescription')" class="px-5 py-2.5 bg-white/10 hover:bg-white/20 text-white border border-white/20 text-xs font-bold rounded-xl transition-all">
                                    <span>Scan Prescription</span>
                                </button>
                            </div>
                        </div>

                        <!-- Right 3D Visual Canvas (Medical Cross + Helix DNA) -->
                        <div class="lg:col-span-5 h-[280px] sm:h-[320px] w-full relative flex items-center justify-center">
                            <canvas id="canvas3d" class="w-full h-full block focus:outline-none"></canvas>
                            <div class="absolute bottom-4 right-4 bg-slate-900/80 backdrop-blur-md px-3 py-1.5 rounded-lg border border-slate-700/60 text-[10px] text-brand-300 flex items-center space-x-2 pointer-events-none">
                                <i class="fa-solid fa-cube text-brand-400 animate-spin"></i>
                                <span>3D Interactive Graphics Canvas</span>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- METRICS COUNTER CARDS -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
                    <div onclick="switchTab('find-medicines')" class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition-all cursor-pointer group">
                        <div class="flex items-center justify-between">
                            <div class="p-3 bg-brand-50 rounded-xl text-brand-700 text-xl group-hover:scale-110 transition-transform">
                                <i class="fa-solid fa-font"></i>
                            </div>
                            <span class="text-xs font-bold text-brand-600 bg-brand-50 px-2.5 py-1 rounded-md">A to Z Filter</span>
                        </div>
                        <h3 class="text-2xl font-extrabold text-slate-800 mt-3">26 Letters Covered</h3>
                        <p class="text-xs text-slate-500 mt-1">Instant generic medicine lookup for every letter</p>
                    </div>

                    <div onclick="switchTab('diet-assistance')" class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition-all cursor-pointer group">
                        <div class="flex items-center justify-between">
                            <div class="p-3 bg-emerald-50 rounded-xl text-emerald-700 text-xl group-hover:scale-110 transition-transform">
                                <i class="fa-solid fa-apple-whole"></i>
                            </div>
                            <span class="text-xs font-bold text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-md">Condition Guides</span>
                        </div>
                        <h3 class="text-2xl font-extrabold text-slate-800 mt-3">7 Categories</h3>
                        <p class="text-xs text-slate-500 mt-1">Diabetes, Weight Loss, BP, Thyroid & more</p>
                    </div>

                    <div onclick="switchTab('scan-prescription')" class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition-all cursor-pointer group sm:col-span-2 lg:col-span-1">
                        <div class="flex items-center justify-between">
                            <div class="p-3 bg-blue-50 rounded-xl text-blue-700 text-xl group-hover:scale-110 transition-transform">
                                <i class="fa-solid fa-file-medical"></i>
                            </div>
                            <span class="text-xs font-bold text-blue-600 bg-blue-50 px-2.5 py-1 rounded-md">OCR Simulation</span>
                        </div>
                        <h3 class="text-2xl font-extrabold text-slate-800 mt-3">Rx Image Scanner</h3>
                        <p class="text-xs text-slate-500 mt-1">Extract medicine names from photos</p>
                    </div>
                </div>

                <!-- NAVIGATION MODULE TILES -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-2">
                    <div class="bg-white rounded-xl border border-slate-200 p-6 flex flex-col justify-between shadow-sm">
                        <div>
                            <div class="w-10 h-10 rounded-lg bg-brand-100 text-brand-800 flex items-center justify-center text-lg font-bold mb-4">
                                <i class="fa-solid fa-capsules"></i>
                            </div>
                            <h3 class="font-bold text-base text-slate-800">1. Find Medicines (A-Z)</h3>
                            <p class="text-xs text-slate-500 mt-2 leading-relaxed">
                                Type any letter (e.g., 'p' or 'm') or click alphabet buttons to explore matching generic & branded medicines.
                            </p>
                        </div>
                        <button onclick="switchTab('find-medicines')" class="mt-6 w-full py-2.5 bg-brand-700 hover:bg-brand-800 text-white font-bold text-xs rounded-lg transition-colors flex items-center justify-center space-x-2">
                            <span>Open Medicines Tab</span>
                            <i class="fa-solid fa-arrow-right text-[10px]"></i>
                        </button>
                    </div>

                    <div class="bg-white rounded-xl border border-slate-200 p-6 flex flex-col justify-between shadow-sm">
                        <div>
                            <div class="w-10 h-10 rounded-lg bg-emerald-100 text-emerald-800 flex items-center justify-center text-lg font-bold mb-4">
                                <i class="fa-solid fa-heart-pulse"></i>
                            </div>
                            <h3 class="font-bold text-base text-slate-800">2. Diet Assistance</h3>
                            <p class="text-xs text-slate-500 mt-2 leading-relaxed">
                                Get nutritional guidance tailored for Diabetes, Weight Loss, Thyroid, Hypertension, and Fatty Liver.
                            </p>
                        </div>
                        <button onclick="switchTab('diet-assistance')" class="mt-6 w-full py-2.5 bg-brand-700 hover:bg-brand-800 text-white font-bold text-xs rounded-lg transition-colors flex items-center justify-center space-x-2">
                            <span>Open Diet Tab</span>
                            <i class="fa-solid fa-arrow-right text-[10px]"></i>
                        </button>
                    </div>

                    <div class="bg-white rounded-xl border border-slate-200 p-6 flex flex-col justify-between shadow-sm">
                        <div>
                            <div class="w-10 h-10 rounded-lg bg-blue-100 text-blue-800 flex items-center justify-center text-lg font-bold mb-4">
                                <i class="fa-solid fa-camera"></i>
                            </div>
                            <h3 class="font-bold text-base text-slate-800">3. Scan Prescription</h3>
                            <p class="text-xs text-slate-500 mt-2 leading-relaxed">
                                Upload prescription photos to automatically extract medicine text and calculate generic price savings.
                            </p>
                        </div>
                        <button onclick="switchTab('scan-prescription')" class="mt-6 w-full py-2.5 bg-brand-700 hover:bg-brand-800 text-white font-bold text-xs rounded-lg transition-colors flex items-center justify-center space-x-2">
                            <span>Open Scanner Tab</span>
                            <i class="fa-solid fa-arrow-right text-[10px]"></i>
                        </button>
                    </div>
                </div>

            </div>


            <!-- ==================================================== -->
            <!-- TAB 2: A-Z SEARCHABLE MEDICINE DIRECTORY             -->
            <!-- ==================================================== -->
            <div id="tabView-find-medicines" class="p-6 max-w-7xl w-full mx-auto space-y-6 flex-1 hidden">
                <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 space-y-6">
                    
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 pb-4">
                        <div>
                            <h3 class="text-lg font-bold text-slate-800 flex items-center gap-2">
                                <i class="fa-solid fa-pills text-brand-700"></i>
                                A-Z Medicine & Generic Alternative Finder
                            </h3>
