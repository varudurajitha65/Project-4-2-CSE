        function renderAlphabetButtons() {
            const container = document.getElementById('alphabetBar');
            const alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".split("");
            
            let html = `<button onclick="filterByLetter('ALL')" class="alpha-btn active-letter px-2.5 py-1 text-xs font-semibold border border-slate-200 rounded-md bg-white text-slate-700 hover:bg-brand-50 transition-colors">ALL</button>`;
            
            alphabet.forEach(lettr => {
                html += `<button onclick="filterByLetter('${lettr}')" id="btn-alpha-${lettr}" class="alpha-btn px-2.5 py-1 text-xs font-semibold border border-slate-200 rounded-md bg-white text-slate-700 hover:bg-brand-50 hover:text-brand-700 transition-colors">${lettr}</button>`;
            });
            container.innerHTML = html;
        }

        function filterByLetter(letter) {
            selectedLetter = letter;
            document.getElementById('medSearchInput').value = "";
            document.getElementById('clearSearchBtn').classList.add('hidden');

            document.querySelectorAll('.alpha-btn').forEach(b => b.classList.remove('active-letter'));
            if (letter === 'ALL') {
                document.querySelector('.alpha-btn').classList.add('active-letter');
            } else {
                const b = document.getElementById(`btn-alpha-${letter}`);
                if (b) b.classList.add('active-letter');
            }

            if (letter === 'ALL') {
                renderMedicineList(MEDICINES_DATA);
            } else {
                const filtered = MEDICINES_DATA.filter(m => 
                    m.name.toUpperCase().startsWith(letter) || m.brand.toUpperCase().startsWith(letter)
                );
                renderMedicineList(filtered);
            }
        }

        function handleRealtimeMedSearch() {
            const val = document.getElementById('medSearchInput').value.trim().toLowerCase();
            const clearBtn = document.getElementById('clearSearchBtn');

            if (val.length > 0) {
                clearBtn.classList.remove('hidden');
            } else {
                clearBtn.classList.add('hidden');
                filterByLetter(selectedLetter);
                return;
            }

            // Remove alphabet button highlights during custom typing
            document.querySelectorAll('.alpha-btn').forEach(b => b.classList.remove('active-letter'));

            // Match if name, brand, or category starts with or contains query
            const filtered = MEDICINES_DATA.filter(m => 
                m.name.toLowerCase().includes(val) || 
                m.brand.toLowerCase().includes(val) || 
                m.category.toLowerCase().includes(val)
            );

            renderMedicineList(filtered);
        }

